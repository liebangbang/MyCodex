#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
MyCodex 启动器（开源版，跨机器可用）
- 本体逻辑在 app/backend.py（打包后位于 Contents/Resources/app/backend.py）
- 依赖：Python 3.10+ 与 pywebview（macOS: pip install "pywebview[mac]"）
用法：
  仓库内运行：  python3 macos/MyCodex
  打包为 .app： 见 README 的「构建 .app」一节
"""
import os
import sys

HERE = os.path.dirname(os.path.abspath(__file__))

# 兼容两种布局：
#   A) 仓库布局：macos/MyCodex 与 app/backend.py 同级
#   B) 打包 .app：Contents/MacOS/MyCodex 与 Contents/Resources/app/backend.py
CANDIDATES = [
    os.path.join(HERE, "..", "Resources", "app"),   # .app 内
    os.path.join(os.path.dirname(HERE), "app"),     # 仓库内
]
APP_DIR = None
for c in CANDIDATES:
    p = os.path.abspath(c)
    if os.path.isdir(p):
        APP_DIR = p
        break

if APP_DIR is None:
    sys.stderr.write("找不到 app 目录（backend.py）。请确认仓库结构。\n")
    sys.exit(1)

sys.path.insert(0, APP_DIR)

from backend import main

if __name__ == "__main__":
    main()
